# Copy this file to remote_test.env and replace the example values.
# remote_test.env is ignored by git and should be readable only by its owner.
# Authentication uses SSH keys or an SSH agent; do not store passwords here.

XDS_REMOTE_HOST=remote-host.example.com
XDS_REMOTE_USER=xds-runner
XDS_REMOTE_PORT=22
XDS_REMOTE_RUN_DIR=/home/xds-runner/xds-kvm-run
XDS_REMOTE_LAUNCHER=$XDS_REMOTE_RUN_DIR/launch-qemu.sh
XDS_REMOTE_PID_FILE=$XDS_REMOTE_RUN_DIR/qemu.pid
XDS_REMOTE_MONITOR=$XDS_REMOTE_RUN_DIR/monitor.sock
# Optional local SSH client config. The default is /dev/null.
XDS_SSH_CONFIG=/dev/null

XDS_GUEST_USER=xds
XDS_GUEST_PORT=22222
XDS_GUEST_KEY=$XDS_REMOTE_RUN_DIR/guest_key
XDS_GUEST_REPO=/home/xds/xds
XDS_GUEST_KSRC=/home/xds/oe_knl
XDS_GUEST_DEV_1=/dev/nvme0n1
XDS_GUEST_DEV_2=/dev/nvme0n2

XDS_KERNEL_BASE_VERSION=6.6.0
XDS_MATRIX_BUILD_KERNELS=0
XDS_VM_WAIT_TIMEOUT=240
XDS_TEST_KEEP_WORKDIR=1
